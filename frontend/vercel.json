{
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/:slug((?!(?:api|app|admin|auth|company|employee|login|signup|org|_next|_not-found|404)(?:/|$))[^/.]+)",
      "destination": "/org/index.html"
    },
    {
      "source": "/:slug((?!(?:api|app|admin|auth|company|employee|login|signup|org|_next|_not-found|404)(?:/|$))[^/.]+)/",
      "destination": "/org/index.html"
    },
    {
      "source": "/:slug((?!(?:api|app|admin|auth|company|employee|login|signup|org|_next|_not-found|404)(?:/|$))[^/.]+)/:rest*",
      "destination": "/org/index.html"
    }
  ]
}
