# Application Environment
APP_ENV=development
APP_SECRET_KEY=docmind-super-secret-key-at-least-32-chars-long!
PORT=8000

# Base URLs & CORS
PUBLIC_APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# PostgreSQL 16 + pgvector Database
DATABASE_URL=postgresql+asyncpg://docmind:docmind@localhost:5432/docmind
SYNC_DATABASE_URL=postgresql+psycopg2://docmind:docmind@localhost:5432/docmind
POSTGRES_USER=docmind
POSTGRES_PASSWORD=docmind
POSTGRES_DB=docmind

# Cloudflare R2 S3-Compatible Object Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=docmind-private
R2_ENDPOINT_URL=

# Google Gemini AI APIs
GOOGLE_API_KEY=
LLM_PROVIDER=google
LLM_MODEL=gemini-3.8-flash
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=768

# Product Limits & Governance
AI_FEATURES_ENABLED=true
AI_MONTHLY_BUDGET_USD=50.00
MAX_FILE_MB=20
MAX_PAGES=200
MAX_WORKSPACE_DOCS=20
MAX_WORKSPACE_STORAGE_MB=200
MONTHLY_QUESTION_LIMIT=100
WORKER_CONCURRENCY=1

# Backup Passphrase for AES-256 encrypted snapshots
BACKUP_PASSPHRASE=
